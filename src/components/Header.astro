---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/framework/', label: 'Framework' },
  { href: '/publications/', label: 'Publications' },
];
---
<header style="background: #fff; border-bottom: 1px solid #e2e8f0; padding: 1rem 0;">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
    <a href="/" style="font-weight: 700; font-size: 1.25rem; color: var(--color-primary); text-decoration: none;">Temporal Decoupling</a>
    <nav>
      <ul style="display: flex; gap: 1.5rem; list-style: none;">
        {navLinks.map(link => (
          <li><a href={link.href} style="color: var(--color-text); text-decoration: none; font-weight: 500;">{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
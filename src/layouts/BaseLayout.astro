---
import '../styles/global.css';

interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Temporal Decoupling</title>
  {description && <meta name="description" content={description} />}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
</head>
<body>
  <!-- ✅ Header MUST be inside <body> -->
  <header>
    <div class="header-container">
      <a href="/" class="logo">Temporal Decoupling</a>
      
      <!-- Hamburger Button -->
      <button class="nav-toggle-btn" aria-label="Toggle menu">☰</button>
      
      <!-- Navigation Links -->
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/framework/">Framework</a>
        <a href="/publications/">Publications</a>
      </nav>
    </div>
  </header>

  <!-- Page content loads here -->
  <slot />

  <!-- Toggle Script (runs after DOM is ready) -->
  <script>
    document.querySelector('.nav-toggle-btn')?.addEventListener('click', () => {
      document.querySelector('.nav-links')?.classList.toggle('active');
    });
  </script>

  <!-- KaTeX scripts -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}]});"></script>
</body>
</html>

<style>
  /* Header Base */
  header {
    background: #fff;
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }
  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary, #0F172A);
    text-decoration: none;
  }

  /* Desktop Nav (Default) */
  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .nav-links a {
    color: var(--color-text, #334155);
    text-decoration: none;
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--color-secondary, #2563EB); }

  /* Hide hamburger button on desktop */
  .nav-toggle-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0;
  }

  /* 📱 Mobile Overrides */
  @media (max-width: 768px) {
    .nav-toggle-btn { display: block; }

    .nav-links {
      display: none !important;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      flex-direction: column;
      padding: 1rem 1.5rem;
      gap: 1rem;
      border-bottom: 1px solid var(--color-border, #e2e8f0);
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .nav-links.active {
      display: flex !important;
    }
  }

</style>
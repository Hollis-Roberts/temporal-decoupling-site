---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Reach out to the Temporal Decoupling project.">
  <section class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <div style="max-width: 760px; margin: 0 auto; background: #fff; padding: 2rem; border-radius: 16px; box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);">
      <h1>Contact</h1>
      <p style="margin-bottom: 1.5rem; color: #475569;">Send a message to discuss the Temporal Decoupling framework, collaborations, or questions.</p>
      <form name="contact" method="POST" action="https://formspree.io/f/xbdbvdzw" style="display: grid; gap: 1rem;">
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="bot-field" />

        <label style="display: grid; gap: 0.5rem; font-weight: 600; color: #0f172a;">
          Name
          <input type="text" name="name" required placeholder="Your name" style="width: 100%; padding: 0.9rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; font: inherit;" />
        </label>

        <label style="display: grid; gap: 0.5rem; font-weight: 600; color: #0f172a;">
          Email
          <input type="email" name="email" required placeholder="you@example.com" style="width: 100%; padding: 0.9rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; font: inherit;" />
        </label>

        <label style="display: grid; gap: 0.5rem; font-weight: 600; color: #0f172a;">
          Message
          <textarea name="message" rows="6" required placeholder="Write your message here..." style="width: 100%; padding: 0.9rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; font: inherit;"></textarea>
        </label>

        <button type="submit" class="btn" style="width: fit-content;">Send Message</button>
      </form>
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

// Load all framework sections
const sections = await getCollection('framework');
---
<BaseLayout title="Framework" description="Step-by-step breakdown of the Temporal Decoupling mechanics.">
  <Header />
  <section class="container">
    <h1>The Framework</h1>
    <p style="margin-bottom: 2rem;">Eight foundational steps. Click any section to explore the geometry, equations, and falsifiable predictions.</p>
    <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
      {sections.map((section) => (
        <a href={`/framework/${section.id}/`} style="background: #fff; padding: 1.5rem; border-radius: 8px; border: 1px solid #e2e8f0; text-decoration: none; color: inherit; transition: transform 0.2s;">
          <span style="color: var(--color-secondary); font-weight: 600; font-size: 0.875rem;">STEP {section.data.sectionNumber.toString().padStart(2, '0')}</span>
          <h3 style="margin-top: 0.5rem;">{section.data.title}</h3>
          <p style="color: var(--color-muted); font-size: 0.9rem;">{section.data.subtitle}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
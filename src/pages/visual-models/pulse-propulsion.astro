---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Temporal Pulse Propulsion" description="Interactive simulation comparing standard thrust with temporal pulse mechanics.">
  <article style="padding: 2rem 1rem; max-width: 900px; margin: 0 auto;">
    <h1 style="text-align: center; margin-bottom: 0.5rem;">Temporal Pulse Propulsion</h1>
    <p style="text-align: center; color: #64748b; margin-bottom: 2rem;">
      Compare standard continuous thrust with Temporal Pulse mechanics. Notice how pulse cycling resets temporal resistance, allowing efficient approach to light speed.
    </p>

    <div style="position: relative; background: #0f172a; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.3); border: 1px solid #1e293b;">
      
      <!-- Top UI Layer -->
      <div style="position: absolute; top: 0; left: 0; right: 0; padding: 1rem; display: flex; gap: 1rem; z-index: 10; pointer-events: none;">
        <div style="flex: 1;">
          <div style="display: flex; justify-content: space-between; color: #94a3b8; font-size: 0.8rem; margin-bottom: 0.25rem;">
            <span>Velocity</span>
            <span id="speed-text">0.00% c</span>
          </div>
          <div style="height: 8px; background: #1e293b; border-radius: 4px; overflow: hidden;">
            <div id="speed-bar" style="height: 100%; width: 0%; background: linear-gradient(90deg, #38bdf8, #818cf8); transition: width 0.1s;"></div>
          </div>
        </div>
        <div style="flex: 1;">
          <div style="display: flex; justify-content: space-between; color: #94a3b8; font-size: 0.8rem; margin-bottom: 0.25rem;">
            <span>Temporal Energy</span>
            <span id="energy-text">100%</span>
          </div>
          <div style="height: 8px; background: #1e293b; border-radius: 4px; overflow: hidden;">
            <div id="energy-bar" style="height: 100%; width: 100%; background: linear-gradient(90deg, #34d399, #f59e0b); transition: width 0.1s;"></div>
          </div>
        </div>
        <div style="display: flex; flex-direction: column; justify-content: center; align-items: flex-end; color: #cbd5e1; font-size: 0.85rem; min-width: 60px;">
          <span>Drag</span>
          <span id="drag-val" style="font-weight: bold; color: #f87171;">0.00</span>
        </div>
      </div>

      <canvas id="simCanvas" style="width: 100%; height: 400px; display: block;"></canvas>

      <!-- Controls -->
      <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1rem; display: flex; gap: 0.75rem; justify-content: center; background: linear-gradient(to top, rgba(15,23,42,0.95) 0%, rgba(15,23,42,0) 100%);">
        <button id="mode-btn" style="padding: 0.6rem 1.2rem; background: #334155; color: #f8fafc; border: none; border-radius: 8px; font-weight: 500; cursor: pointer; transition: 0.2s;">Standard Drive</button>
        <button id="thrust-btn" style="padding: 0.6rem 2rem; background: #2563eb; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; box-shadow: 0 0 15px rgba(37,99,235,0.4); transition: 0.2s; user-select: none;">
          THRUST
        </button>
      </div>
    </div>

    <p style="margin-top: 1.5rem; color: #475569; font-size: 0.9rem; line-height: 1.6; text-align: center;">
      <strong>Standard Drive:</strong> Continuous thrust fights increasing temporal drag. Energy drains steadily.<br>
      <strong>Pulse Drive:</strong> Short, high-intensity bursts reset chronological friction. Coasting preserves momentum between pulses.
    </p>
  </article>

  <script is:inline>
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      const canvas = document.getElementById('simCanvas');
      const ctx = canvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      
      // UI Elements
      const speedBar = document.getElementById('speed-bar');
      const speedText = document.getElementById('speed-text');
      const energyBar = document.getElementById('energy-bar');
      const energyText = document.getElementById('energy-text');
      const dragVal = document.getElementById('drag-val');
      const modeBtn = document.getElementById('mode-btn');
      const thrustBtn = document.getElementById('thrust-btn');

      // Physics State
      let velocity = 0; // 0 to 1 (1 = c)
      let energy = 100;
      let maxEnergy = 100;
      let isThrusting = false;
      let driveMode = 'standard'; // 'standard' | 'pulse'
      let pulseTimer = 0;
      let pulseCooldown = 0;
      
      // Constants
      const ACCEL_STANDARD = 0.0008;
      const ACCEL_PULSE = 0.006;
      const PULSE_DURATION = 50; // frames
      const PULSE_COOLDOWN = 40; // frames
      const DRAG_COEFF = 0.002;
      const ENERGY_DRAIN_STD = 0.15;
      const ENERGY_DRAIN_PULSE = 0.8;
      const ENERGY_REGEN = 0.08;

      // Visual State
      let stars = [];
      let gridOffset = 0;
      let shipX = 0;
      let trail = [];

      function resize() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        ctx.scale(dpr, dpr);
        shipX = rect.width * 0.2;
        
        // Init stars if empty
        if (stars.length === 0) {
          for(let i=0; i<120; i++) {
            stars.push({
              x: Math.random() * rect.width,
              y: Math.random() * rect.height,
              size: Math.random() * 1.5 + 0.5,
              speed: Math.random() * 0.5 + 0.2
            });
          }
        }
      }
      window.addEventListener('resize', resize);
      resize();

      // Controls
      modeBtn.addEventListener('click', () => {
        driveMode = driveMode === 'standard' ? 'pulse' : 'standard';
        modeBtn.textContent = driveMode === 'standard' ? 'Standard Drive' : 'Pulse Drive';
        modeBtn.style.background = driveMode === 'standard' ? '#334155' : '#7c3aed';
        pulseTimer = 0;
        pulseCooldown = 0;
      });

      function startThrust() {
        if (driveMode === 'pulse') {
          if (pulseCooldown <= 0 && energy > 5) {
            pulseTimer = PULSE_DURATION;
            isThrusting = true;
          }
        } else {
          isThrusting = true;
        }
      }
      function stopThrust() { isThrusting = false; }

      thrustBtn.addEventListener('mousedown', startThrust);
      thrustBtn.addEventListener('mouseup', stopThrust);
      thrustBtn.addEventListener('mouseleave', stopThrust);
      thrustBtn.addEventListener('touchstart', (e) => { e.preventDefault(); startThrust(); });
      thrustBtn.addEventListener('touchend', stopThrust);

      // Physics & Render Loop
      function update() {
        const w = canvas.width / dpr;
        const h = canvas.height / dpr;

        // Drag calculation
        const drag = DRAG_COEFF * velocity * velocity;
        dragVal.textContent = drag.toFixed(3);

        // Energy & Thrust
        if (isThrusting && energy > 0) {
          let accel = driveMode === 'pulse' ? ACCEL_PULSE : ACCEL_STANDARD;
          let drain = driveMode === 'pulse' ? ENERGY_DRAIN_PULSE : ENERGY_DRAIN_STD;
          
          if (driveMode === 'pulse') {
            pulseTimer--;
            pulseCooldown = PULSE_COOLDOWN;
            if (pulseTimer <= 0) {
              isThrusting = false;
            }
          }
          
          velocity += accel;
          energy -= drain;
        } else {
          if (energy < maxEnergy) energy += ENERGY_REGEN;
          if (driveMode === 'pulse' && pulseCooldown > 0) pulseCooldown--;
        }

        // Apply Drag (Momentum Conservation)
        velocity = Math.max(0, velocity - drag);
        velocity = Math.min(1, velocity);
        energy = Math.max(0, Math.min(maxEnergy, energy));

        // Update UI
        const pct = (velocity * 100).toFixed(1);
        speedText.textContent = `${pct}% c`;
        speedBar.style.width = `${pct}%`;
        energyBar.style.width = `${energy}%`;
        energyText.textContent = `${Math.round(energy)}%`;
        
        // Energy bar color warning
        energyBar.style.background = energy < 20 ? '#ef4444' : 'linear-gradient(90deg, #34d399, #f59e0b)';

        // Scroll grid & stars
        const scrollSpeed = velocity * 12;
        gridOffset = (gridOffset + scrollSpeed) % 40;
        
        stars.forEach(s => {
          s.x -= s.speed * scrollSpeed;
          if (s.x < 0) s.x = w;
        });

        // Trail effect
        if (velocity > 0.01) {
          trail.push({ x: shipX, y: h/2, alpha: 1 });
        }
        if (trail.length > 15) trail.shift();
        trail.forEach(t => t.alpha -= 0.06);
        trail = trail.filter(t => t.alpha > 0);

        draw(w, h);
        requestAnimationFrame(update);
      }

      function draw(w, h) {
        ctx.clearRect(0, 0, w, h);

        // Grid Background
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.15)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let x = -gridOffset; x < w; x += 40) {
          ctx.moveTo(x, 0);
          ctx.lineTo(x, h);
        }
        for (let y = 0; y < h; y += 40) {
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
        }
        ctx.stroke();

        // Stars
        ctx.fillStyle = '#ffffff';
        stars.forEach(s => {
          ctx.globalAlpha = s.speed * 0.8;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI*2);
          ctx.fill();
        });
        ctx.globalAlpha = 1;

        // Trail
        trail.forEach((t, i) => {
          const width = 20 * (1 - i/trail.length) * velocity;
          ctx.fillStyle = driveMode === 'pulse' ? `rgba(139, 92, 246, ${t.alpha})` : `rgba(56, 189, 248, ${t.alpha})`;
          ctx.beginPath();
          ctx.ellipse(t.x - (15-i)*3, t.y, width, 4, 0, 0, Math.PI*2);
          ctx.fill();
        });

        // Ship
        ctx.fillStyle = '#f8fafc';
        ctx.beginPath();
        ctx.moveTo(shipX + 20, h/2);
        ctx.lineTo(shipX - 10, h/2 - 12);
        ctx.lineTo(shipX - 10, h/2 + 12);
        ctx.closePath();
        ctx.fill();

        // Engine Glow
        if (isThrusting && energy > 0) {
          const glowSize = 10 + Math.random() * 8 + (velocity * 20);
          const grad = ctx.createRadialGradient(shipX - 12, h/2, 0, shipX - 12, h/2, glowSize);
          grad.addColorStop(0, driveMode === 'pulse' ? '#a78bfa' : '#38bdf8');
          grad.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(shipX - 12, h/2, glowSize, 0, Math.PI*2);
          ctx.fill();
        }
      }

      update();
    }
  </script>
</BaseLayout>
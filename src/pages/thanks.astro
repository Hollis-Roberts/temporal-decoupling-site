---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thank You" description="Your message has been received.">
  <section class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <div style="max-width: 760px; margin: 0 auto; background: #fff; padding: 2rem; border-radius: 16px; box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08); text-align: center;">
      <h1>Thank You</h1>
      <p style="margin-bottom: 1.5rem; color: #475569;">Your message has been sent successfully. I’ll review it and get back to you shortly.</p>
      <a href="/" class="btn">Return Home</a>
    </div>
  </section>
</BaseLayout>
